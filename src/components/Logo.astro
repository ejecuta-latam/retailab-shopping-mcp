---
type Props = {
  class?: string;
  title?: string;
};

const { class: className = "", title = "retailab" } = Astro.props;
---

<svg
  class:list={["logo-mark", className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden={title ? undefined : true}
  role={title ? "img" : "presentation"}
>
  {title ? <title>{title}</title> : null}
  <!-- Aisle rails: the store path -->
  <path d="M8 5v22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
  <path d="M24 5v22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
  <!-- Lab node: agent bridging both sides -->
  <path d="M8 16h16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
  <circle cx="16" cy="16" r="4.25" fill="currentColor" />
  <circle cx="16" cy="16" r="1.6" class="logo-mark__core" />
</svg>

<style>
  .logo-mark {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
    color: var(--accent);
  }

  .logo-mark__core {
    fill: var(--paper, #f3f8fa);
  }
</style>
