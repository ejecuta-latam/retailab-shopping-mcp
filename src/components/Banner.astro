---
const brand = "shopping-mcp";
const support =
  "A shared tool profile so agents shop the same way on every store — then track orders through your integration.";
---

<section class="banner" aria-labelledby="banner-brand">
  <div class="banner__glow" aria-hidden="true"></div>
  <div class="banner__content">
    <p class="banner__kicker">WebMCP for retail</p>
    <h1 id="banner-brand" class="banner__brand">{brand}</h1>
    <p class="banner__support">{support}</p>
    <div class="banner__actions">
      <a class="banner__cta banner__cta--primary" href="#get-started">Get started</a>
      <a class="banner__cta banner__cta--ghost" href="#demo">View demo</a>
    </div>
  </div>
</section>

<style>
  .banner {
    position: relative;
    display: grid;
    align-items: end;
    min-height: calc(100vh - 4.1rem);
    overflow: hidden;
    padding: clamp(3rem, 10vh, 7rem) 1.5rem clamp(3.5rem, 12vh, 8rem);
  }

  .banner__glow {
    position: absolute;
    inset: auto -10% -30% 20%;
    height: 70%;
    background:
      radial-gradient(circle at 30% 40%, rgba(13, 143, 91, 0.16), transparent 42%),
      radial-gradient(circle at 70% 60%, rgba(90, 160, 190, 0.16), transparent 45%);
    filter: blur(8px);
    pointer-events: none;
  }

  .banner__content {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    margin: 0 auto 0 0;
    width: min(100%, 72rem);
    margin-inline: auto;
    animation: rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .banner__kicker {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .banner__brand {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 11vw, 6.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .banner__support {
    max-width: 34rem;
    margin: 1.4rem 0 0;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.55;
    color: var(--mist);
    animation: rise 700ms cubic-bezier(0.22, 1, 0.36, 1) 120ms both;
  }

  .banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
    animation: rise 700ms cubic-bezier(0.22, 1, 0.36, 1) 220ms both;
  }

  .banner__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.7rem 1.25rem;
    border-radius: 0.55rem;
    font-size: 0.95rem;
    font-weight: 650;
    transition:
      transform 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .banner__cta:hover {
    transform: translateY(-1px);
  }

  .banner__cta--primary {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .banner__cta--primary:hover {
    background: #0b7a4e;
  }

  .banner__cta--ghost {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.65);
    color: var(--ink);
  }

  .banner__cta--ghost:hover {
    border-color: rgba(16, 36, 44, 0.22);
    background: #fff;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .banner {
      align-items: center;
    }

    .banner__actions {
      width: 100%;
    }

    .banner__cta {
      flex: 1 1 auto;
    }
  }
</style>
