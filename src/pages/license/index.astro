SOFTWARE.`;
---

<BaseLayout
  title="License — retailab"
  description="shopping-mcp and the retailab site are released under the MIT License."
>
  <main class="docs license-page">
    <h1>License</h1>
    <p>
      <strong style="color: var(--ink); font-weight: 600;">shopping-mcp</strong> and this
      website are open source under the <strong style="color: var(--ink); font-weight: 600;"
        >MIT License</strong
      >, copyright retailab (2026).
    </p>
    <p>
      You may use, copy, modify, merge, publish, distribute, sublicense, and sell copies of
      the software, provided the copyright notice and permission notice are included.
    </p>
    <p>
      The same text ships as <code>LICENSE</code> at the root of the GitHub repository so
      GitHub can detect it in the About section.
    </p>

    <h2>Full text</h2>
    <pre class="license-page__text">{licenseText}</pre>

    <p class="docs__note">
      Plain text: <a href="/license.txt">/license.txt</a>
      · Repo root: <code>LICENSE</code> (GitHub About)
      · SPDX: <code>MIT</code>
    </p>
  </main>
</BaseLayout>
