---
import SiteHead from "../components/SiteHead.astro";
import Nav from "../components/Nav";
import Banner from "../components/Banner";
import DemoShowcase from "../components/demo/DemoShowcase";
import ExplainBanner from "../components/ExplainBanner";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/landing.css";
import "../styles/demo.css";
import "../styles/footer.css";
---

<html lang="en">
  <head>
    <SiteHead
      title="shopping-mcp — retailab"
      description="shopping-mcp by retailab — WebMCP tools so agents understand shopping the same way on every store."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav client:load />
    <main>
      <Banner client:load />
      <DemoShowcase client:load />
      <ExplainBanner client:load />
    </main>
    <Footer />
  </body>
</html>
